{
  "datasets": [
    {
      "name": "dim_calendar",
      "displayName": "Calendar",
      "config": {
        "version": "1.1",
        "source": "retail_s.retail_gold.dim_calendar",
        "comment": "Calendar dimension for time-based retail analysis",
        "dimensions": [
          {
            "name": "date",
            "expr": "date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "day_of_week",
            "expr": "day_of_week"
          },
          {
            "name": "day_of_week_name",
            "expr": "day_of_week_name"
          },
          {
            "name": "month",
            "expr": "month"
          },
          {
            "name": "month_name",
            "expr": "month_name"
          },
          {
            "name": "year_month",
            "expr": "year_month"
          }
        ]
      }
    },
    {
      "name": "dim_product",
      "displayName": "Products",
      "config": {
        "version": "1.1",
        "source": "retail_s.retail_gold.dim_product",
        "comment": "Product dimension for retail sales analysis",
        "dimensions": [
          {
            "name": "product_id",
            "expr": "product_id"
          },
          {
            "name": "product_name",
            "expr": "product_name"
          },
          {
            "name": "category",
            "expr": "category"
          },
          {
            "name": "subcategory",
            "expr": "subcategory"
          },
          {
            "name": "brand",
            "expr": "brand"
          }
        ]
      }
    },
    {
      "name": "fact_sales",
      "displayName": "Sales Facts",
      "config": {
        "source": "retail_s.retail_gold.fact_sales",
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_quantity",
            "expr": "SUM(quantity)"
          },
          {
            "name": "transaction_count",
            "expr": "COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "unique_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "avg_order_value",
            "expr": "AVG(amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "name": "net_revenue",
            "expr": "SUM(amount - discount_amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_discount",
            "expr": "SUM(discount_amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "Fact sales transactions for the retail dashboard",
        "dimensions": [
          {
            "name": "transaction_date",
            "expr": "transaction_date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "transaction_id",
            "expr": "transaction_id"
          },
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "product_id",
            "expr": "product_id"
          },
          {
            "name": "store_id",
            "expr": "store_id"
          },
          {
            "name": "payment_mode",
            "expr": "payment_mode"
          },
          {
            "name": "sales_channel",
            "expr": "sales_channel"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "Calendar",
          "datasetName": "dim_calendar"
        },
        {
          "name": "Products",
          "datasetName": "dim_product"
        },
        {
          "name": "Sales_Facts",
          "datasetName": "fact_sales"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "Sales_Facts",
          "to": "Products",
          "on": "`Sales_Facts`.`product_id` = `Products`.`product_id`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "Sales_Facts",
          "to": "Calendar",
          "on": "`Sales_Facts`.`transaction_date` = `Calendar`.`date`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
  ],
